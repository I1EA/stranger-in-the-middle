# ==============================================================================
# STRANGER IN THE MIDDLE (SITM) - Environment Configuration Example
# ==============================================================================

# Server
PORT=3000
NODE_ENV=development

# Session Security
SESSION_SECRET=your-super-secret-key-change-this-in-production

# CORS Origin
CORS_ORIGIN=*

# Optional PostgreSQL Database URL (Leave unset for zero-config built-in in-memory database)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/stranger_db
