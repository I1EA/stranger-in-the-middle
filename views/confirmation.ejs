<%- include('partials/header', { title }) %>
<%- include('partials/navbar') %>

<main class="max-w-3xl mx-auto w-full px-4 sm:px-6 py-16">
  <section class="glass-panel rounded-3xl border border-emerald-500/30 p-8 sm:p-12 text-center">
    <div class="mx-auto w-16 h-16 rounded-full bg-emerald-500/15 text-emerald-400 flex items-center justify-center text-3xl">&#10003;</div>
    <p class="mt-6 text-xs font-bold uppercase tracking-widest text-emerald-400">Booking confirmed</p>
    <h1 class="mt-2 text-4xl font-black text-white"><%= booking.movieTitle %></h1>
    <p class="mt-3 text-slate-400"><%= booking.venue %> &middot; <%= booking.showtime %></p>
    <div class="mt-8 grid sm:grid-cols-2 gap-4 text-left">
      <div class="rounded-2xl bg-black/30 border border-slate-800 p-4"><span class="text-xs text-slate-500">Booking ID</span><div class="mt-1 font-mono text-white"><%= booking.bookingId %></div></div>
      <div class="rounded-2xl bg-black/30 border border-slate-800 p-4"><span class="text-xs text-slate-500">Seats</span><div class="mt-1 text-white"><%= (booking.seats || []).map(seat => seat.label || seat).join(', ') %></div></div>
    </div>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/bookings" class="inline-flex rounded-xl bg-red-600 px-5 py-3 font-bold text-white hover:bg-red-500">View my tickets</a>
      <button type="button" data-cancel-booking="<%= booking.bookingId %>" class="inline-flex rounded-xl border border-red-500/50 px-5 py-3 font-bold text-red-300 hover:bg-red-950/50">Cancel tickets</button>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
