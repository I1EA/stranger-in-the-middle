<%- include('partials/header', { title }) %>
<%- include('partials/navbar') %>

<main class="max-w-6xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6 sm:mb-8">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-red-400">SITM Arena</p>
      <h1 class="mt-2 text-2xl sm:text-4xl font-black text-white wrap-break-word"><%= session.movie.title %></h1>
      <p class="mt-2 text-sm text-slate-400">Room <span class="font-mono text-slate-200"><%= sessionId %></span> &middot; Group of <span id="groupSizeDisplay"><%= session.groupSize %></span></p>
    </div>
    <a href="/" class="inline-flex w-fit rounded-xl border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-200 hover:border-red-500 hover:text-white">Browse movies</a>
  </div>

  <div class="grid min-w-0 lg:grid-cols-[1.2fr_0.8fr] gap-4 sm:gap-6">
    <%- include('partials/seat-matrix') %>
    <div class="space-y-6">
      <div class="flex flex-col items-stretch gap-3 rounded-xl border border-slate-800 bg-slate-950/60 p-3 sm:flex-row sm:items-center sm:justify-between">
        <span id="agentStatus" class="w-full min-w-0 text-xs sm:text-sm text-emerald-400 wrap-break-word">AI options ready. Select a block.</span>
        <div class="flex w-full flex-wrap justify-start gap-2 sm:justify-end">
          <select id="groupSize" class="rounded-lg border border-slate-700 bg-slate-900 px-2 py-2 text-xs text-white" aria-label="Group size">
            <% for (let size = 1; size <= 8; size += 1) { %><option value="<%= size %>" <%= session.groupSize === size ? 'selected' : '' %>><%= size %> seats</option><% } %>
          </select>
          <select id="manualRow" class="rounded-lg border border-slate-700 bg-slate-900 px-2 py-2 text-xs text-white" aria-label="Seat row">
            <% ['A', 'B', 'C', 'D', 'E', 'F'].forEach((row) => { %><option value="<%= row %>">Row <%= row %></option><% }) %>
          </select>
          <select id="manualColumn" class="rounded-lg border border-slate-700 bg-slate-900 px-2 py-2 text-xs text-white" aria-label="Starting seat column"></select>
          <button id="applyManualBtn" type="button" class="rounded-xl border border-emerald-500/60 px-3 py-2 text-xs font-bold text-emerald-300 hover:bg-emerald-950/40">Select block</button>
          <button id="startVoteBtn" type="button" class="rounded-xl bg-amber-500 px-3 py-2 text-xs font-bold text-slate-950 hover:bg-amber-400">Start vote</button>
        </div>
      </div>
      <%- include('partials/voting-arena') %>
      <%- include('partials/ai-terminal') %>

      <!-- PAYMENT CHOICE -->
      <div id="paymentChoice" class="hidden mt-4 p-4 rounded-2xl border border-amber-500/30 bg-amber-950/20">
        <h3 class="text-lg font-bold text-white mb-3">How do you want to book?</h3>
        <div class="flex flex-wrap gap-4">
          <button id="splitPayBtn" class="flex-1 min-w-[150px] rounded-xl bg-emerald-600 px-4 py-3 text-sm font-bold text-white hover:bg-emerald-500 transition-colors">Each person pays their own</button>
          <button id="strangerPayBtn" class="flex-1 min-w-[150px] rounded-xl bg-red-600 px-4 py-3 text-sm font-bold text-white hover:bg-red-500 transition-colors">Stranger books all (one person pays)</button>
          <button id="birthdayPayBtn" class="flex-1 min-w-[150px] rounded-xl bg-purple-600 px-4 py-3 text-sm font-bold text-white hover:bg-purple-500 transition-colors">Birthday split (group shares)</button>
        </div>
        <p class="mt-3 text-xs text-slate-400">Each person pays for their own seat, one person pays for everyone, or the group shares the birthday person's seat.</p>
      </div>

      <!-- INDIVIDUAL PAYMENT -->
      <div id="splitPayment" class="hidden mt-4 p-4 rounded-2xl border border-emerald-500/30 bg-emerald-950/20">
        <h4 class="text-sm font-bold text-white mb-3">Each person pays for their seat</h4>
        <div id="seatPaymentList" class="space-y-2"></div>
        <button id="confirmSplitPayment" class="mt-4 rounded-xl bg-emerald-600 px-4 py-2 text-sm font-bold text-white hover:bg-emerald-500 transition-colors hidden">Confirm all payments</button>
      </div>

      <!-- BIRTHDAY PAYMENT -->
      <div id="birthdayPayment" class="hidden mt-4 p-4 rounded-2xl border border-purple-500/30 bg-purple-950/20">
        <h4 class="text-sm font-bold text-white mb-3">Birthday Split - Everyone shares the birthday person's seat</h4>
        <p class="text-sm text-slate-300 mb-3">Select who the birthday person is:</p>
        <div id="birthdayPersonList" class="space-y-2"></div>
        <button id="confirmBirthdayPayment" class="mt-4 rounded-xl bg-purple-600 px-4 py-2 text-sm font-bold text-white hover:bg-purple-500 transition-colors hidden">Confirm birthday split</button>
      </div>

      <button id="bookBtn" type="button" class="w-full rounded-xl bg-emerald-500 px-4 py-3 text-sm font-black text-slate-950 hover:bg-emerald-400">Lock seats and book tickets</button>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

<script>
  const sessionId = <%- JSON.stringify(sessionId) %>;
  const sessionSuggestions = <%- JSON.stringify(session.suggestions || []) %>;
  const availableSeats = <%- JSON.stringify(session.available || []) %>;
  let suggestions = sessionSuggestions.map((option) => ({ ...option, votes: 0 }));
  let selectedSeats = [];
  let votingActive = false;
  let hasVoted = false;
  let timerInterval;
  let timeLeft = 120;
  let groupSize = <%- JSON.stringify(session.groupSize) %>;

  const seatLabel = (index) => {
    const row = Math.floor(index / 8);
    return String.fromCharCode(65 + row) + (index % 8 + 1);
  };

  function selectOption(index) {
    if (votingActive) return;
    if (index < 0 || !suggestions[index]) return;
    selectedSeats = suggestions[index].seats.slice();
    document.querySelectorAll('.rec-card').forEach((card, cardIndex) => {
      card.classList.toggle('active', cardIndex === index);
    });
    document.getElementById('agentStatus').textContent = 'Selected: Option ' + (index + 1) + ' (seats ' + selectedSeats.map(seatLabel).join(', ') + ')';
    renderSeats();
    fetch('/api/sessions/' + encodeURIComponent(sessionId) + '/select-seats', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ seatIndices: selectedSeats })
    }).catch(() => {});
  }

  function updateColumnChoices() {
    const size = Number(document.getElementById('groupSize').value);
    const column = document.getElementById('manualColumn');
    column.innerHTML = '';
    for (let start = 1; start <= 9 - size; start += 1) {
      column.add(new Option('Seats ' + start + '-' + (start + size - 1), start));
    }
  }

  function applyManualSelection() {
    const size = Number(document.getElementById('groupSize').value);
    const row = document.getElementById('manualRow').selectedIndex;
    const start = Number(document.getElementById('manualColumn').value) - 1;
    const seats = Array.from({ length: size }, (_, offset) => row * 8 + start + offset);
    if (seats.some((seat) => !availableSeats[seat])) {
      document.getElementById('agentStatus').textContent = 'That block contains an occupied seat. Choose another row or column.';
      return;
    }
    selectedSeats = seats;
    document.querySelectorAll('.rec-card').forEach((card) => card.classList.remove('active'));
    document.getElementById('agentStatus').textContent = 'Selected manual block: ' + seats.map(seatLabel).join(', ');
    renderSeats();
    fetch('/api/sessions/' + encodeURIComponent(sessionId) + '/select-seats', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ seatIndices: selectedSeats })
    }).catch(() => {});
  }

  // ============================================================
  // BOOK TICKETS - WITH PAYMENT CHECK
  // ============================================================
  async function bookTickets() {
    if (selectedSeats.length === 0) {
      document.getElementById('agentStatus').textContent = 'Select a seat block before booking.';
      return;
    }
    
    // Check if payment choice is visible
    var paymentChoice = document.getElementById('paymentChoice');
    if (paymentChoice.classList.contains('hidden')) {
      document.getElementById('agentStatus').textContent = 'Please choose a payment option first.';
      paymentChoice.classList.remove('hidden');
      paymentChoice.style.display = 'block';
      paymentChoice.style.visibility = 'visible';
      paymentChoice.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }
    
    const response = await fetch('/api/sessions/' + encodeURIComponent(sessionId) + '/book', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ seatIndices: selectedSeats, bookedBy: 'Group Coordinator' })
    });
    const data = await response.json();
    if (!response.ok) {
      document.getElementById('agentStatus').textContent = data.error?.message || 'Booking failed.';
      return;
    }
    window.location.href = '/confirmation/' + data.data.booking.bookingId;
  }

  function renderRecommendations() {
    const container = document.getElementById('recContainer');
    container.innerHTML = '';
    suggestions.forEach((option, index) => {
      const card = document.createElement('div');
      card.setAttribute('role', 'button');
      card.setAttribute('tabindex', '0');
      card.className = 'rec-card text-left border border-slate-700 rounded-xl p-4 space-y-2';
      card.innerHTML = '<div class="label">Option ' + (index + 1) + '</div>' +
        '<div class="desc">Seats ' + option.seats.map(seatLabel).join(', ') + '</div>' +
        '<div class="desc">' + option.view + ' · ' + option.leg + '</div>' +
        '<div class="vote-count">0 votes</div>' +
        '<div class="flex gap-2 pt-2">' +
        '<button type="button" class="select-btn rounded-lg border border-slate-600 px-3 py-1.5 text-xs font-bold text-slate-200 hover:border-emerald-400 hover:text-white">Select</button>' +
        '<button type="button" class="vote-btn rounded-lg bg-red-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-red-500 disabled:cursor-not-allowed disabled:opacity-50" disabled>Vote</button>' +
        '</div>';
      card.addEventListener('click', () => selectOption(index));
      card.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          selectOption(index);
        }
      });
      card.querySelector('.select-btn').addEventListener('click', (event) => {
        event.stopPropagation();
        selectOption(index);
      });
      card.querySelector('.vote-btn').addEventListener('click', (event) => {
        event.stopPropagation();
        castVote(index);
      });
      container.appendChild(card);
    });
  }

  function renderSeats() {
    const grid = document.getElementById('seatGrid');
    if (!grid.children.length) {
      for (let row = 0; row < 6; row += 1) {
        const label = document.createElement('div');
        label.className = 'text-center text-xs font-bold text-slate-500';
        label.textContent = String.fromCharCode(65 + row);
        grid.appendChild(label);
        for (let column = 0; column < 8; column += 1) {
          const index = row * 8 + column;
          const seat = document.createElement('button');
          seat.type = 'button';
          seat.className = 'cinema-seat aspect-square min-w-0 flex items-center justify-center text-[10px] sm:text-xs font-bold';
          seat.textContent = column + 1;
          seat.disabled = !availableSeats[index];
          grid.appendChild(seat);
        }
      }
    }
    grid.querySelectorAll('.cinema-seat').forEach((seat, seatIndex) => {
      const index = Math.floor(seatIndex / 8) * 8 + (seatIndex % 8);
      seat.classList.toggle('seat-selected', selectedSeats.includes(index));
      seat.classList.toggle('seat-avail', availableSeats[index] && !selectedSeats.includes(index));
      seat.classList.toggle('seat-taken', !availableSeats[index]);
    });
  }

  async function castVote(index) {
    if (!votingActive || hasVoted) return;
    hasVoted = true;
    suggestions[index].votes += 1;
    document.querySelectorAll('.rec-card').forEach((card, cardIndex) => {
      card.querySelector('.vote-count').textContent = suggestions[cardIndex].votes + ' votes';
      const button = card.querySelector('.vote-btn');
      button.disabled = true;
      button.textContent = suggestions[cardIndex].votes + ' votes';
    });
    document.getElementById('votingStatus').textContent = 'You voted! Waiting for others...';
    await fetch('/api/sessions/' + encodeURIComponent(sessionId) + '/vote', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ optionIndex: index, voterName: 'Group Member' })
    }).catch(() => {});
  }

  function updateTimer() {
    document.getElementById('timerDisplay').textContent = Math.floor(timeLeft / 60) + ':' + String(timeLeft % 60).padStart(2, '0');
  }

  async function startVoting() {
    if (suggestions.length < 2) return;
    votingActive = true;
    hasVoted = false;
    suggestions.forEach((option) => { option.votes = 0; });
    document.getElementById('votingBar').classList.remove('hidden');
    document.getElementById('startVoteBtn').classList.add('hidden');
    document.getElementById('agentStatus').textContent = 'Voting open! Choose your option.';
    document.querySelectorAll('.vote-btn').forEach((button) => { button.disabled = false; button.textContent = 'Vote'; });
    timeLeft = 120;
    updateTimer();
    clearInterval(timerInterval);
    timerInterval = setInterval(() => {
      timeLeft -= 1;
      updateTimer();
      if (timeLeft <= 0) endVoting();
    }, 1000);
    await fetch('/api/sessions/' + encodeURIComponent(sessionId) + '/start-voting', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ durationSeconds: 120 })
    }).catch(() => {});
  }

  async function endVoting() {
    if (!votingActive) return;
    votingActive = false;
    clearInterval(timerInterval);
    const winnerIndex = suggestions.reduce((best, option, index) => option.votes > suggestions[best].votes ? index : best, 0);
    if (suggestions[winnerIndex].votes > 0) {
      selectOption(winnerIndex);
      document.getElementById('votingStatus').textContent = 'Winner: Option ' + (winnerIndex + 1);
      document.getElementById('agentStatus').textContent = 'Option ' + (winnerIndex + 1) + ' selected by group vote.';
      
      // Show payment choice
      var paymentChoice = document.getElementById('paymentChoice');
      if (paymentChoice) {
        paymentChoice.classList.remove('hidden');
        paymentChoice.style.display = 'block';
        paymentChoice.style.visibility = 'visible';
        paymentChoice.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      document.getElementById('agentStatus').textContent = 'Choose how to book: split, all at once, or birthday.';
    } else {
      document.getElementById('votingStatus').textContent = 'No votes cast. Select an option to continue.';
    }
    document.querySelectorAll('.vote-btn').forEach((button) => { button.disabled = true; });
    await fetch('/api/sessions/' + encodeURIComponent(sessionId) + '/end-voting', { method: 'POST' }).catch(() => {});
  }

  // ============================================================
  // PAYMENT HANDLERS
  // ============================================================

  // SPLIT PAYMENT
  document.getElementById('splitPayBtn').addEventListener('click', function() {
    document.getElementById('paymentChoice').classList.add('hidden');
    document.getElementById('splitPayment').classList.remove('hidden');
    var list = document.getElementById('seatPaymentList');
    list.innerHTML = '';
    var pricePerSeat = 12.50;
    selectedSeats.forEach(function(seatIndex2, idx) {
      var seatNum = seatIndex2 + 1;
      var row = String.fromCharCode(65 + Math.floor(seatIndex2 / 8));
      var col = (seatIndex2 % 8) + 1;
      var item = document.createElement('div');
      item.className = 'flex items-center justify-between p-2 rounded-lg bg-slate-800/50';
      item.innerHTML = '<span class="text-sm text-white">Person ' + (idx + 1) + ' - Seat ' + row + col + ' - GBP ' + pricePerSeat.toFixed(2) + '</span><button class="pay-seat-btn rounded-lg bg-emerald-600 px-3 py-1 text-xs font-bold text-white hover:bg-emerald-500 transition-colors" data-seat="' + seatNum + '" data-person="' + (idx + 1) + '">Pay Now</button>';
      list.appendChild(item);
    });
    var payBtns = document.querySelectorAll('.pay-seat-btn');
    payBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        this.textContent = 'Paid!';
        this.className = 'rounded-lg bg-slate-600 px-3 py-1 text-xs font-bold text-white cursor-default';
        this.disabled = true;
        var allPaid = document.querySelectorAll('.pay-seat-btn:not([disabled])').length === 0;
        if (allPaid) {
          document.getElementById('confirmSplitPayment').classList.remove('hidden');
        }
      });
    });
    document.getElementById('confirmSplitPayment').classList.add('hidden');
  });

  // STRANGER BOOKS ALL
  document.getElementById('strangerPayBtn').addEventListener('click', function() {
    document.getElementById('paymentChoice').classList.add('hidden');
    if (confirm('Stranger will book all seats. One person will pay for everyone. Continue?')) {
      bookTickets();
    } else {
      document.getElementById('paymentChoice').classList.remove('hidden');
    }
  });

  // BIRTHDAY SPLIT
  document.getElementById('birthdayPayBtn').addEventListener('click', function() {
    document.getElementById('paymentChoice').classList.add('hidden');
    document.getElementById('birthdayPayment').classList.remove('hidden');
    var list2 = document.getElementById('birthdayPersonList');
    list2.innerHTML = '';
    var totalSeats2 = selectedSeats.length;
    var pricePerSeat2 = 12.50;
    var birthdayPrice = pricePerSeat2 / totalSeats2;
    selectedSeats.forEach(function(seatIndex3, idx2) {
      var seatNum2 = seatIndex3 + 1;
      var row2 = String.fromCharCode(65 + Math.floor(seatIndex3 / 8));
      var col2 = (seatIndex3 % 8) + 1;
      var isBirthdayPerson = idx2 === 0;
      var item2 = document.createElement('div');
      item2.className = 'flex items-center justify-between p-2 rounded-lg bg-slate-800/50';
      if (isBirthdayPerson) {
        item2.innerHTML = '<span class="text-sm text-white">Birthday Person - Seat ' + row2 + col2 + ' - GBP ' + pricePerSeat2.toFixed(2) + '</span><span class="text-xs text-purple-400">Everyone shares this cost</span>';
      } else {
        var sharedCost = pricePerSeat2 + birthdayPrice;
        item2.innerHTML = '<span class="text-sm text-white">Person ' + (idx2 + 1) + ' - Seat ' + row2 + col2 + ' - GBP ' + sharedCost.toFixed(2) + '</span><button class="pay-birthday-btn rounded-lg bg-purple-600 px-3 py-1 text-xs font-bold text-white hover:bg-purple-500 transition-colors" data-seat="' + seatNum2 + '" data-person="' + (idx2 + 1) + '">Pay Now</button>';
      }
      list2.appendChild(item2);
    });
    var bdayBtns = document.querySelectorAll('.pay-birthday-btn');
    bdayBtns.forEach(function(btn2) {
      btn2.addEventListener('click', function() {
        this.textContent = 'Paid!';
        this.className = 'rounded-lg bg-slate-600 px-3 py-1 text-xs font-bold text-white cursor-default';
        this.disabled = true;
        var allPaid2 = document.querySelectorAll('.pay-birthday-btn:not([disabled])').length === 0;
        if (allPaid2) {
          document.getElementById('confirmBirthdayPayment').classList.remove('hidden');
        }
      });
    });
    document.getElementById('confirmBirthdayPayment').classList.add('hidden');
  });

  // CONFIRM SPLIT PAYMENT
  document.getElementById('confirmSplitPayment').addEventListener('click', function() {
    var seatNumbers = selectedSeats.map(function(s) { return s + 1; });
    seatNumbers.forEach(function(n) { availableSeats[n - 1] = false; });
    selectedSeats = [];
    suggestions = [];
    document.getElementById('recContainer').innerHTML = '';
    document.getElementById('votingBar').classList.add('hidden');
    document.getElementById('splitPayment').classList.add('hidden');
    document.getElementById('paymentChoice').classList.add('hidden');
    renderSeats();
    document.getElementById('agentStatus').textContent = 'All seats paid and confirmed!';
    document.getElementById('bookBtn').textContent = 'Booking confirmed!';
    document.getElementById('bookBtn').disabled = true;
  });

  // CONFIRM BIRTHDAY PAYMENT
  document.getElementById('confirmBirthdayPayment').addEventListener('click', function() {
    var seatNumbers2 = selectedSeats.map(function(s) { return s + 1; });
    seatNumbers2.forEach(function(n) { availableSeats[n - 1] = false; });
    selectedSeats = [];
    suggestions = [];
    document.getElementById('recContainer').innerHTML = '';
    document.getElementById('votingBar').classList.add('hidden');
    document.getElementById('birthdayPayment').classList.add('hidden');
    document.getElementById('paymentChoice').classList.add('hidden');
    renderSeats();
    document.getElementById('agentStatus').textContent = 'Birthday booking confirmed! Everyone shared the cost.';
    document.getElementById('bookBtn').textContent = 'Booking confirmed!';
    document.getElementById('bookBtn').disabled = true;
  });

  // GROUP SIZE CHANGE
  document.getElementById('groupSize').addEventListener('change', function() {
    groupSize = parseInt(this.value);
    document.getElementById('groupSizeDisplay').textContent = groupSize;
    updateColumnChoices();
  });

  document.getElementById('startVoteBtn')?.addEventListener('click', startVoting);
  document.getElementById('endVotingBtn')?.addEventListener('click', endVoting);
  document.getElementById('applyManualBtn')?.addEventListener('click', applyManualSelection);
  document.getElementById('bookBtn')?.addEventListener('click', bookTickets);

  updateColumnChoices();
  renderSeats();
  renderRecommendations();
</script>