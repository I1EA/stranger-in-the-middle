<%- include('partials/header', { title }) %>
<%- include('partials/navbar') %>

<main class="max-w-6xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-10">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-red-400">SITM Arena</p>
      <h1 class="mt-2 text-3xl sm:text-4xl font-black text-white"><%= session.movie.title %></h1>
      <p class="mt-2 text-slate-400">Room <span class="font-mono text-slate-200"><%= sessionId %></span> &middot; Group of <%= session.groupSize %></p>
    </div>
    <a href="/" class="inline-flex w-fit rounded-xl border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-200 hover:border-red-500 hover:text-white">Browse movies</a>
  </div>

  <div class="grid lg:grid-cols-[1.2fr_0.8fr] gap-6">
    <%- include('partials/seat-matrix') %>
    <div class="space-y-6">
      <%- include('partials/voting-arena') %>
      <%- include('partials/ai-terminal') %>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
