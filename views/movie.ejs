<%- include('partials/header', { title }) %>
<%- include('partials/navbar') %>

<main class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-10">
  <a href="/" class="text-sm text-slate-400 hover:text-white">&larr; Back to movies</a>
  <section class="mt-6 grid lg:grid-cols-[1.1fr_0.9fr] gap-8 items-center">
    <img src="<%= movie.backdrop || movie.poster %>" alt="<%= movie.title %>" class="w-full aspect-video object-cover rounded-3xl border border-slate-800 shadow-2xl" />
    <div>
      <span class="text-xs font-bold uppercase tracking-widest text-red-400"><%= movie.badge || 'Now showing' %></span>
      <h1 class="mt-3 text-4xl sm:text-5xl font-black text-white"><%= movie.title %></h1>
      <p class="mt-4 text-slate-300 leading-relaxed"><%= movie.description %></p>
      <div class="mt-6 grid grid-cols-2 gap-3 text-sm text-slate-400">
        <span><strong class="text-white">Venue</strong><br><%= movie.venue %></span>
        <span><strong class="text-white">Screen</strong><br><%= movie.screen %></span>
        <span><strong class="text-white">Showtime</strong><br><%= movie.time %></span>
        <span><strong class="text-white">Seats left</strong><br><%= availableCount %> / <%= totalSeats %></span>
      </div>
      <a href="/" class="mt-8 inline-flex items-center gap-2 rounded-xl bg-red-600 px-5 py-3 font-bold text-white hover:bg-red-500">Start a group session &rarr;</a>
    </div>
  </section>
</main>

<%- include('partials/footer') %>