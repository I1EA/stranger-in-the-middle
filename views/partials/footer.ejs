<!-- WebMCP Interactive Tool Inspector Drawer -->
<div id="mcpDrawer" class="fixed inset-y-0 right-0 w-full sm:w-96 bg-[#0c0c1a] border-l border-slate-800 shadow-2xl z-50 transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
  <div class="p-4 border-b border-slate-800 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
      <h3 class="font-bold text-white text-sm">WebMCP AI Tool Terminal</h3>
    </div>
    <button id="closeMcpDrawer" type="button" class="p-1 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  
  <div class="p-4 flex-1 overflow-y-auto space-y-4 text-xs">
    <p class="text-slate-400">
      This app exposes native tools to AI agents using the <strong>WebMCP Polyfill</strong>. You can trigger these tools directly below:
    </p>

    <div class="space-y-3">
      <!-- Tool 1 -->
      <div class="p-3 rounded-xl bg-slate-900 border border-slate-800">
        <div class="flex items-center justify-between mb-1.5">
          <span class="font-mono font-bold text-emerald-400">search_movies()</span>
          <button type="button" data-mcp-tool="search_movies" class="px-2 py-1 rounded bg-red-600 hover:bg-red-500 text-white font-semibold text-[11px]">Run</button>
        </div>
        <p class="text-slate-400 text-[11px]">Returns list of available movies, venues, and prices.</p>
      </div>

      <!-- Tool 2 -->
      <div class="p-3 rounded-xl bg-slate-900 border border-slate-800">
        <div class="flex items-center justify-between mb-1.5">
          <span class="font-mono font-bold text-emerald-400">get_available_seats()</span>
          <button type="button" data-mcp-tool="get_available_seats" class="px-2 py-1 rounded bg-red-600 hover:bg-red-500 text-white font-semibold text-[11px]">Run</button>
        </div>
        <p class="text-slate-400 text-[11px]">Queries available seats for Spider-Man.</p>
      </div>

      <!-- Tool 3 -->
      <div class="p-3 rounded-xl bg-slate-900 border border-slate-800">
        <div class="flex items-center justify-between mb-1.5">
          <span class="font-mono font-bold text-emerald-400">stranger_vote()</span>
          <button type="button" data-mcp-tool="stranger_vote" class="px-2 py-1 rounded bg-red-600 hover:bg-red-500 text-white font-semibold text-[11px]">Run</button>
        </div>
        <p class="text-slate-400 text-[11px]">Computes optimal contiguous blocks for 4 friends.</p>
      </div>

      <!-- Tool 4 -->
      <div class="p-3 rounded-xl bg-slate-900 border border-slate-800">
        <div class="flex items-center justify-between mb-1.5">
          <span class="font-mono font-bold text-emerald-400">book_tickets()</span>
          <button type="button" data-mcp-tool="book_tickets" class="px-2 py-1 rounded bg-red-600 hover:bg-red-500 text-white font-semibold text-[11px]">Run</button>
        </div>
        <p class="text-slate-400 text-[11px]">Books the highest-scoring available block for a new group.</p>
      </div>

      <!-- Tool 5 -->
      <div class="p-3 rounded-xl bg-slate-900 border border-slate-800">
        <div class="flex items-center justify-between mb-1.5">
          <span class="font-mono font-bold text-emerald-400">cancel_booking()</span>
          <button type="button" data-mcp-tool="cancel_booking" class="px-2 py-1 rounded bg-red-600 hover:bg-red-500 text-white font-semibold text-[11px]">Run</button>
        </div>
        <p class="text-slate-400 text-[11px]">Cancels a demo booking and releases its seats.</p>
      </div>
    </div>

    <div>
      <h4 class="font-bold text-slate-300 text-xs mb-1.5">Tool Output Console</h4>
      <pre id="mcpConsole" class="p-3 rounded-xl bg-black/80 border border-slate-800 font-mono text-[11px] text-emerald-300 overflow-x-auto h-48 whitespace-pre-wrap">WebMCP Ready. Click 'Run' on any tool above to execute.</pre>
    </div>
  </div>
</div>

<script>
  function toggleMcpDrawer() {
    const drawer = document.getElementById('mcpDrawer');
    drawer.classList.toggle('translate-x-full');
  }

  document.getElementById('webmcpStatusBadge')?.addEventListener('click', toggleMcpDrawer);
  document.getElementById('closeMcpDrawer')?.addEventListener('click', toggleMcpDrawer);
  document.getElementById('endVotingBtn')?.addEventListener('click', () => {
    if (typeof endVoting === 'function') endVoting();
  });
  document.querySelectorAll('[data-mcp-tool]').forEach((button) => {
    button.addEventListener('click', () => {
      const input = button.dataset.mcpTool === 'get_available_seats'
        ? { movieId: 'spiderman' }
        : button.dataset.mcpTool === 'stranger_vote'
          ? { movieId: 'spiderman', groupSize: 4 }
          : {};
      testMcpTool(button.dataset.mcpTool, input);
    });
  });
  document.querySelectorAll('[data-cancel-booking]').forEach((button) => {
    button.addEventListener('click', async () => {
      if (!window.confirm('Cancel this booking and release its seats?')) return;
      button.disabled = true;
      try {
        const response = await fetch('/api/bookings/' + encodeURIComponent(button.dataset.cancelBooking), { method: 'DELETE' });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error?.message || 'Cancellation failed.');
        window.location.href = '/bookings';
      } catch (error) {
        button.disabled = false;
        window.alert(error.message);
      }
    });
  });

  async function testMcpTool(toolName, input = {}) {
    const consoleEl = document.getElementById('mcpConsole');
    consoleEl.textContent = 'Executing tool: ' + toolName + '...\n';
    try {
      if (window.navigator?.modelContext) {
        // Try direct WebMCP tool call
        const ctx = window.navigator.modelContext;
        consoleEl.textContent = 'Calling navigator.modelContext with tool: ' + toolName + '...\n';
      }
      
      // Execute matching API query for interactive demo
      if (toolName === 'search_movies') {
        const res = await fetch('/api/movies');
        const data = await res.json();
        consoleEl.textContent = JSON.stringify(data, null, 2);
      } else if (toolName === 'get_available_seats') {
        const res = await fetch('/api/movies/spiderman/seats');
        const data = await res.json();
        consoleEl.textContent = JSON.stringify(data, null, 2);
      } else if (toolName === 'stranger_vote') {
        const res = await fetch('/api/sessions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ movieId: 'spiderman', groupSize: 4 })
        });
        const data = await res.json();
        const createdSession = data.data.session;
        consoleEl.textContent = 'SITM AI Optimizer computed:\n' + JSON.stringify(createdSession.suggestions, null, 2) + '\n\nOpening the voting room...';
        window.location.href = '/session/' + encodeURIComponent(createdSession.id);
      } else if (toolName === 'book_tickets') {
        const sessionRes = await fetch('/api/sessions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ movieId: 'spiderman', groupSize: 4 })
        });
        const sessionData = await sessionRes.json();
        const session = sessionData.data.session;
        const seats = session.suggestions[0]?.seats || [];
        const bookingRes = await fetch('/api/sessions/' + session.id + '/book', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ seatIndices: seats, bookedBy: 'Stranger In The Middle AI' })
        });
        const bookingData = await bookingRes.json();
        consoleEl.textContent = 'SITM AI booked session ' + session.id + ':\n' + JSON.stringify(bookingData, null, 2);
      } else if (toolName === 'cancel_booking') {
        const sessionRes = await fetch('/api/sessions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ movieId: 'spiderman', groupSize: 2 })
        });
        const sessionData = await sessionRes.json();
        const session = sessionData.data.session;
        const bookingRes = await fetch('/api/sessions/' + session.id + '/book', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ seatIndices: session.suggestions[0].seats, bookedBy: 'Stranger In The Middle AI' })
        });
        const bookingData = await bookingRes.json();
        const cancelRes = await fetch('/api/bookings/' + bookingData.data.booking.bookingId, { method: 'DELETE' });
        const cancelData = await cancelRes.json();
        consoleEl.textContent = 'SITM AI cancelled booking ' + bookingData.data.booking.bookingId + ':\n' + JSON.stringify(cancelData, null, 2);
      }
    } catch (err) {
      consoleEl.textContent = 'Error: ' + err.message;
    }
  }
</script>
</body>
</html>
