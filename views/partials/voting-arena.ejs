<%# Real-time Voting Arena Component %>
<div class="space-y-6">

  <!-- Voting Status Bar & Countdown Timer -->
  <div id="votingBar" class="glass-panel rounded-2xl p-5 border border-amber-500/30 bg-gradient-to-r from-amber-950/20 via-slate-900/60 to-amber-950/20 shadow-xl flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-amber-400 shrink-0">
        <svg class="w-5 h-5 animate-spin" style="animation-duration: 4s;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div>
        <div id="votingStatus" class="font-bold text-white text-sm sm:text-base">Group Voting in Progress...</div>
        <div class="text-xs text-amber-400/80">Every member votes on their preferred seat block</div>
      </div>
    </div>

    <!-- Timer & End Button -->
    <div class="flex items-center gap-3">
      <div class="px-4 py-2 rounded-xl bg-black/60 border border-amber-500/40 text-center min-w-[90px]">
        <span class="text-[10px] uppercase font-bold text-slate-400 block leading-none mb-1">Time Left</span>
        <span id="timerDisplay" class="font-mono text-xl sm:text-2xl font-black text-amber-400 tracking-wider">02:00</span>
      </div>
      
      <button 
        id="endVotingBtn"
        type="button"
        class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700 text-xs font-semibold transition-all"
      >
        End Early
      </button>
    </div>
  </div>

  <!-- Recommendations Cards Grid -->
  <div>
    <div class="flex items-center justify-between mb-3">
      <h3 class="text-sm font-bold uppercase tracking-wider text-slate-300 flex items-center gap-2">
        <svg class="w-4 h-4 text-red-500" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
        <span>AI-Scored Contiguous Options</span>
      </h3>
      <span class="text-xs text-slate-500 font-medium">Click a card to preview on screen</span>
    </div>

    <div id="recContainer" class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <!-- Generated via JS renderRecommendations() -->
    </div>
  </div>

</div>
