<%# Stranger In The Middle AI Agent Live Terminal %>
<div class="glass-panel rounded-3xl p-5 sm:p-6 border border-slate-800/80 shadow-2xl relative overflow-hidden flex flex-col justify-between">
  
  <div class="ai-scanline"></div>

  <!-- Terminal Header -->
  <div class="flex items-center justify-between pb-4 border-b border-slate-800/80 mb-4">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-xl bg-blue-600/20 border border-blue-500/40 flex items-center justify-center text-blue-400 font-black text-xs shadow-inner">
        AI
      </div>
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-white flex items-center gap-1.5">
          <span>SITM Coordinator Bot</span>
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
        </h4>
        <span class="text-[11px] text-slate-400">Anti-Stranger Contiguity Engine</span>
      </div>
    </div>
    
    <span class="px-2.5 py-1 rounded-full bg-slate-800/80 border border-slate-700 text-[10px] font-mono text-emerald-400">
      ● ACTIVE LOCK
    </span>
  </div>

  <!-- Metric Gauges -->
  <div class="grid grid-cols-2 gap-3 mb-4 text-xs font-mono">
    <div class="p-3 rounded-2xl bg-black/40 border border-slate-800">
      <span class="text-slate-500 text-[10px] block uppercase">Sightline Quality</span>
      <span id="sightlineMetric" class="text-emerald-400 font-bold text-sm">9.8 / 10 (Direct Center)</span>
    </div>
    <div class="p-3 rounded-2xl bg-black/40 border border-slate-800">
      <span class="text-slate-500 text-[10px] block uppercase">Stranger Risk</span>
      <span class="text-emerald-400 font-bold text-sm">0.0% (Single Lock)</span>
    </div>
  </div>

  <!-- Terminal Log Feed -->
  <div class="flex-1 space-y-2 font-mono text-[11px] text-slate-400 bg-black/60 p-3.5 rounded-2xl border border-slate-800/80 overflow-y-auto max-h-36">
    <div class="flex items-start gap-1.5 text-slate-300">
      <span class="text-red-500">❯</span>
      <span id="agentLog1">Initialized session state. Calculating geometric seat distances...</span>
    </div>
    <div class="flex items-start gap-1.5 text-blue-400">
      <span class="text-blue-500">❯</span>
      <span id="agentLog2">Evaluated acoustic center & legroom factors across 48 cinema seats.</span>
    </div>
    <div class="flex items-start gap-1.5 text-emerald-400">
      <span class="text-emerald-500">❯</span>
      <span id="agentLog3">Ready for group voting. No strangers permitted in winning block.</span>
    </div>
  </div>

  <!-- Anti-Stranger Guarantee Footer -->
  <div class="mt-4 pt-3 border-t border-slate-800/60 flex items-center justify-between text-[11px] text-slate-400">
    <span class="flex items-center gap-1.5">
      <svg class="w-3.5 h-3.5 text-amber-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
      </svg>
      <span>Contiguous Seat Guarantee</span>
    </span>
    <span class="text-slate-500">WebMCP v1.0</span>
  </div>

</div>
