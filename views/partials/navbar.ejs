<header class="sticky top-0 z-40 w-full border-b border-slate-800/80 bg-[#080811]/90 backdrop-blur-xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
    
    <!-- Logo & Brand -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none">
      <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-red-600 via-rose-600 to-amber-500 p-0.5 shadow-lg shadow-red-600/30 group-hover:scale-105 transition-transform">
        <div class="w-full h-full bg-[#0d0d1a] rounded-[14px] flex items-center justify-center">
          <svg class="w-6 h-6 text-red-500 group-hover:text-red-400 transition-colors" fill="currentColor" viewBox="0 0 24 24">
            <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm0 4h16V6H4v2zm0 4h7V9H4v3zm9 0h7V9h-7v3zm-9 4h16v-3H4v3z"/>
          </svg>
        </div>
      </div>
      <div class="flex flex-col">
        <div class="flex items-center gap-2">
          <span class="text-xl font-extrabold tracking-tight text-white group-hover:text-red-400 transition-colors">STRANGER</span>
          <span class="text-xs px-2 py-0.5 rounded-full bg-red-600/20 text-red-400 border border-red-500/30 font-bold uppercase tracking-wider">IN THE MIDDLE</span>
        </div>
        <span class="text-[11px] text-slate-400 font-medium hidden sm:inline">AI Group Cinema Coordinator</span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 bg-slate-900/60 p-1.5 rounded-2xl border border-slate-800 text-sm font-medium">
      <a href="/" class="px-4 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800/80 transition-all flex items-center gap-1.5">
        <svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
        </svg>
        Movies
      </a>
      <a href="/#how-it-works" class="px-4 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800/80 transition-all flex items-center gap-1.5">
        <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        How It Works
      </a>
      <a href="/bookings" class="px-4 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800/80 transition-all flex items-center gap-1.5">
        <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
        </svg>
        My Tickets
      </a>
    </nav>

    <!-- Actions & WebMCP Tool Badge -->
    <div class="flex items-center gap-3">
      
      <!-- Join by Session ID Input -->
      <form action="/session" method="GET" onsubmit="event.preventDefault(); const id = document.getElementById('quickSessionId').value.trim(); if(id) window.location.href='/session/' + id;" class="hidden lg:flex items-center relative">
        <input 
          type="text" 
          id="quickSessionId" 
          placeholder="Enter room code..." 
          class="w-40 xl:w-48 pl-8 pr-3 py-1.5 text-xs rounded-xl bg-slate-900/90 border border-slate-700/80 text-white placeholder-slate-500 focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500 transition-all"
        />
        <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
        </svg>
        <button type="submit" class="ml-1.5 px-3 py-1.5 text-xs font-semibold rounded-xl bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition-colors">Join</button>
      </form>

      <!-- WebMCP Live Status Pill -->
      <button 
        id="webmcpStatusBadge" 
        onclick="toggleMcpDrawer()" 
        title="WebMCP (Model Context Protocol) is enabled. Click to test AI tools." 
        class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-950/50 border border-emerald-500/40 text-emerald-400 text-xs font-semibold hover:bg-emerald-900/50 transition-all cursor-pointer shadow-sm"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>WebMCP AI</span>
      </button>

      <!-- Start Group CTA -->
      <a 
        href="/#movie-catalog" 
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-500 hover:to-rose-500 text-white text-xs sm:text-sm font-bold shadow-lg shadow-red-600/30 hover:shadow-red-600/50 hover:scale-[1.02] active:scale-[0.98] transition-all"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>Start Group</span>
      </a>

    </div>
  </div>
</header>
