<%- include('partials/header', { title }) %>
<%- include('partials/navbar') %>

<main class="cinema-spotlight flex-1">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12">
    <div class="max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-[0.3em] text-red-400">AI-coordinated group cinema</p>
      <h1 class="mt-4 text-5xl sm:text-7xl font-black leading-[0.95] text-white">No strangers between you.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">SITM finds the best contiguous seats, lets your group vote together, and locks the winning block in one checkout.</p>
    </div>
  </section>

  <section id="movie-catalog" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="flex items-end justify-between gap-4 mb-6">
      <div><p class="text-xs font-bold uppercase tracking-widest text-slate-500">Tonight's programme</p><h2 class="mt-2 text-3xl font-black text-white">Choose your screening</h2></div>
      <span class="hidden sm:block text-sm text-slate-500"><%= movies.length %> films in the catalogue</span>
    </div>
    <div id="movieList" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">
      <% movies.forEach(function(m) { %>
        <article class="group glass-panel rounded-2xl overflow-hidden border border-slate-800 hover:border-red-500/50 transition-all hover:-translate-y-1 flex flex-col" data-movie-id="<%= m.id %>">
          <div class="relative aspect-4/5 overflow-hidden bg-slate-900">
            <img src="<%= m.poster %>" alt="<%= m.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            <div class="absolute inset-0 bg-linear-to-t from-[#080811] via-transparent to-transparent"></div>
            <span class="absolute top-3 left-3 rounded-full px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-white" style="background-color: <%= m.badgeColor || '#dc2626' %>"><%= m.badge || 'Available' %></span>
            <span class="absolute bottom-3 left-4 text-amber-300 text-sm font-bold">&#9733; <%= m.imdbRating %></span>
          </div>
          <div class="p-5 flex flex-col flex-1">
            <h3 class="text-xl font-bold text-white leading-tight"><%= m.title %></h3>
            <p class="mt-2 text-xs text-slate-400"><%= m.venue %> &middot; <%= m.time %></p>
            <p class="mt-3 text-sm text-slate-400 line-clamp-2"><%= m.description %></p>
            <div class="mt-auto pt-5 flex items-center justify-between gap-3">
              <span class="text-sm font-bold text-white">£<%= Number(m.ticketPrice).toFixed(2) %> <span class="font-normal text-slate-500">/ ticket</span></span>
              <button type="button" data-start-session="<%= m.id %>" class="rounded-xl bg-red-600 px-3 py-2 text-xs font-bold text-white hover:bg-red-500 transition-colors">Start group</button>
            </div>
          </div>
        </article>
      <% }); %>
    </div>
  </section>

    <section id="how-it-works" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 scroll-mt-24">
        <div class="border-y border-slate-800/80 py-12">
            <div class="max-w-2xl mb-8">
                <p class="text-xs font-bold uppercase tracking-widest text-amber-400">The SITM method</p>
                <h2 class="mt-2 text-3xl font-black text-white">One room. One shared decision.</h2>
                <p class="mt-3 text-slate-400 leading-relaxed">Stranger In The Middle turns a group chat debate into a simple cinema checkout, with the best available seats surfaced for everyone.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <article class="rounded-2xl border border-slate-800 bg-slate-950/50 p-5">
                    <span class="text-2xl font-black text-red-400">01</span>
                    <h3 class="mt-4 text-lg font-bold text-white">Pick a film</h3>
                    <p class="mt-2 text-sm leading-relaxed text-slate-400">Choose a screening from the live catalogue and open a private group room.</p>
                </article>
                <article class="rounded-2xl border border-slate-800 bg-slate-950/50 p-5">
                    <span class="text-2xl font-black text-amber-400">02</span>
                    <h3 class="mt-4 text-lg font-bold text-white">Compare seat blocks</h3>
                    <p class="mt-2 text-sm leading-relaxed text-slate-400">SITM scores contiguous blocks by view, legroom, and current availability.</p>
                </article>
                <article class="rounded-2xl border border-slate-800 bg-slate-950/50 p-5">
                    <span class="text-2xl font-black text-emerald-400">03</span>
                    <h3 class="mt-4 text-lg font-bold text-white">Vote and book</h3>
                    <p class="mt-2 text-sm leading-relaxed text-slate-400">Everyone votes in the same room, then the winning seats are locked in one checkout.</p>
                </article>
            </div>
        </div>
    </section>

  <section id="sessionSection" class="hidden max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
      <div><p class="text-xs font-bold uppercase tracking-widest text-red-400">Live group room</p><h2 class="mt-2 text-3xl font-black text-white">Find your shared seats</h2><p id="movieName" class="mt-2 text-slate-400"></p><p id="movieDetails" class="text-xs text-slate-500"></p></div>
    <button id="backToMoviesBtn" type="button" class="rounded-xl border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-300 hover:border-red-500 hover:text-white">Change movie</button>
    </div>
    <div id="shareBanner" class="hidden mb-5 rounded-2xl border border-blue-500/30 bg-blue-950/30 p-4 text-sm text-blue-200"><strong>Invite your group:</strong> share this room link. <button id="copySessionLinkBtn" type="button" class="ml-3 font-bold text-white underline">Copy invite link</button></div>
    <div class="mb-6 flex flex-wrap items-center gap-3 rounded-2xl border border-slate-800 bg-slate-950/60 p-4">
      <label for="groupSize" class="text-sm text-slate-400">Group size</label><select id="groupSize" class="rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-white"><option value="2">2</option><option value="3">3</option><option value="4" selected>4</option><option value="5">5</option><option value="6">6</option></select>
    <button id="findBtn" class="rounded-xl bg-red-600 px-4 py-2 text-sm font-bold text-white hover:bg-red-500">Find best blocks</button><button id="startVoteBtn" class="hidden rounded-xl border border-amber-500/50 px-4 py-2 text-sm font-bold text-amber-300 hover:bg-amber-950/40">Start group vote</button><span id="agentStatus" class="text-sm text-emerald-400"></span><span id="statusBar" class="w-full text-xs text-slate-500 sm:w-auto sm:ml-auto">Status: <span class="highlight">Ready</span></span>
    </div>
    <div id="votingBar" class="voting-bar hidden mb-6"><div><div id="votingStatus" class="status-text">Waiting for votes...</div><div class="text-xs text-amber-400/70">Everyone chooses their preferred block</div></div><div id="timerDisplay" class="timer">2:00</div><button id="endVotingBtn" class="btn-danger">End voting</button></div>
    <div id="recContainer" class="rec-wrap mb-6"></div>
    <div class="screen">SCREEN</div><div id="seatGrid" class="seat-grid"></div>
    <div class="legend"><span><span style="background:#e5e7eb"></span> Available</span><span><span style="background:#22c55e"></span> Selected</span><span><span style="background:#ef4444"></span> Taken</span><span><span style="background:#3b82f6"></span> Suggested</span><span><span style="background:#fbbf24"></span> Winning</span></div>
    <div class="flex-center"><button class="btn-success" id="bookBtn" style="display:none">Confirm and pay</button><button class="btn-secondary" id="agentBookBtn" style="display:none">Stranger books all</button><button class="btn-outline" id="resetBtn">Reset session</button></div>
  </section>
</main>

<%- include('partials/footer') %>

    <!-- INITIAL SERVER DATA INJECTION -->
    <script>
        window.__SERVER_DATA__ = {
            movies: <%- JSON.stringify(typeof movies !== 'undefined' ? movies : []) %>,
            initialSessionId: <%- JSON.stringify(typeof initialSessionId !== 'undefined' ? initialSessionId : null) %>
        };
    </script>

    <script>
        // DATA CATALOG
        const defaultMovies = {
            spiderman: {
                id: 'spiderman',
                title: 'Spider-Man: Beyond the Spider-Verse',
                time: '7:00 PM',
                venue: 'Odeon Luxe Leicester Square',
                screen: 'Screen 1 · Dolby Cinema',
                ticketPrice: 18.50
            },
            dune2: {
                id: 'dune2',
                title: 'Dune: Part Two (IMAX 70mm)',
                time: '8:30 PM',
                venue: 'BFI IMAX Waterloo',
                screen: 'Grand IMAX Screen',
                ticketPrice: 24.00
            },
            oppenheimer: {
                id: 'oppenheimer',
                title: 'Oppenheimer (70mm Exclusive)',
                time: '6:15 PM',
                venue: 'Science Museum IMAX',
                screen: 'Ronson Theatre',
                ticketPrice: 20.00
            },
            deadpool: {
                id: 'deadpool',
                title: 'Deadpool & Wolverine',
                time: '9:15 PM',
                venue: 'Vue Cinema West End',
                screen: 'Screen 3 · Recliner Luxe',
                ticketPrice: 16.50
            }
        };

        const movies = {};
        if (window.__SERVER_DATA__ && window.__SERVER_DATA__.movies && window.__SERVER_DATA__.movies.length > 0) {
            window.__SERVER_DATA__.movies.forEach(m => {
                movies[m.id] = m;
            });
        } else {
            Object.assign(movies, defaultMovies);
        }

        const ROWS = 6;
        const COLS = 8;
        const TOTAL = ROWS * COLS;

        let currentSessionId = window.__SERVER_DATA__?.initialSessionId || null;
        let available = [];
        let selectedMovieId = 'spiderman';
        let selectedSeats = [];
        let suggestions = [];
        let currentSuggestionIdx = -1;

        // Voting state
        let votes = {};
        let timerInterval = null;
        let timeLeft = 120;
        let votingActive = false;
        let groupSize = 4;
        let hasVoted = false;
        let sessionActive = false;

        // Helpers
        function showToast(msg) {
            const existing = document.querySelector('.toast');
            if (existing) existing.remove();
            const t = document.createElement('div');
            t.className = 'toast';
            t.textContent = msg;
            document.body.appendChild(t);
            setTimeout(() => t.remove(), 2500);
        }

        function copySessionLink() {
            const link = window.location.origin + '/session/' + (currentSessionId || 'spiderman-group');
            if (navigator.clipboard) {
                navigator.clipboard.writeText(link).then(() => {
                    showToast('🔗 Invite link copied to clipboard!');
                }).catch(() => {
                    prompt('Copy this invite link for your group:', link);
                });
            } else {
                prompt('Copy this invite link for your group:', link);
            }
        }

        function shuffleSome() {
            available = new Array(TOTAL).fill(true);
            const count = Math.floor(Math.random() * 6) + 6;
            let done = 0;
            while (done < count) {
                const idx = Math.floor(Math.random() * TOTAL);
                if (available[idx]) {
                    available[idx] = false;
                    done++;
                }
            }
        }

        function seatIndex(row, col) { return row * COLS + col; }
        function seatNumber(idx) { return idx + 1; }
        function seatLabel(idx) {
            const rowLetter = 'ABCDEF'[Math.floor(idx / COLS)] || '?';
            const colNum = (idx % COLS) + 1;
            return rowLetter + colNum;
        }

        function updateStatus(msg) {
            document.getElementById('statusBar').innerHTML = 'Status: <span class="highlight">' + msg + '</span>';
        }

        function backToMovies() {
            clearInterval(timerInterval);
            document.getElementById('sessionSection').classList.add('hidden');
            document.getElementById('movieList').classList.remove('hidden');
            updateStatus('Ready — select a movie to start a group session.');
        }

        // Score Calculation
        function scoreBlock(seats) {
            let total = 0;
            for (let i = 0; i < seats.length; i++) {
                const idx = seats[i];
                const row = Math.floor(idx / COLS);
                const col = idx % COLS;
                const centerDist = Math.abs(col - 3.5);
                const viewScore = 10 - centerDist * 2.2;
                let legScore = 0;
                if (row === 0) legScore = 9;
                else if (row === 1) legScore = 7;
                else if (row === 2) legScore = 6;
                else if (row === 3) legScore = 4;
                else if (row === 4) legScore = 2;
                else legScore = 0;
                total += viewScore + legScore;
            }
            return total / seats.length;
        }

        function describe(row, startCol, groupSize) {
            const centerDist = Math.abs((startCol + groupSize / 2) - 3.5);
            let view = centerDist < 1.5 ? 'Center view' : centerDist < 2.8 ? 'Good view' : 'Side view';
            let leg = row === 0 ? 'Extra legroom' : row <= 2 ? 'Good legroom' : 'Standard legroom';
            return { view, leg };
        }

        // Find Best Blocks
        function findBestBlocks(groupSize) {
            const blocks = [];

            // Horizontal blocks
            for (let row = 0; row < ROWS; row++) {
                for (let start = 0; start <= COLS - groupSize; start++) {
                    const seats = [];
                    let valid = true;
                    for (let c = start; c < start + groupSize; c++) {
                        const idx = seatIndex(row, c);
                        if (!available[idx]) { valid = false; break; }
                        seats.push(idx);
                    }
                    if (valid && seats.length === groupSize) {
                        const score = scoreBlock(seats);
                        const desc = describe(row, start, groupSize);
                        blocks.push({ seats, score, row, start, view: desc.view, leg: desc.leg, votes: 0 });
                    }
                }
            }

            // Vertical fallback if not enough
            if (blocks.length < 3) {
                for (let col = 0; col < COLS; col++) {
                    for (let startRow = 0; startRow <= ROWS - groupSize; startRow++) {
                        const seats = [];
                        let valid = true;
                        for (let r = startRow; r < startRow + groupSize; r++) {
                            const idx = seatIndex(r, col);
                            if (!available[idx]) { valid = false; break; }
                            seats.push(idx);
                        }
                        if (valid && seats.length === groupSize) {
                            const score = scoreBlock(seats);
                            const desc = describe(startRow, col, groupSize);
                            let dup = false;
                            for (let b of blocks) {
                                if (b.seats.join(',') === seats.join(',')) { dup = true; break; }
                            }
                            if (!dup) blocks.push({ seats, score, row: startRow, start: col, view: desc.view, leg: desc.leg, votes: 0 });
                        }
                    }
                }
            }

            blocks.sort((a, b) => b.score - a.score);
            return blocks.slice(0, 3);
        }

        // Render Seats
        function renderSeats() {
            const container = document.getElementById('seatGrid');
            container.innerHTML = '';
            const rowLabels = 'ABCDEF';

            let winningSeats = [];
            if (!votingActive && suggestions.length > 0) {
                let maxVotes = -1;
                let winnerIdx = -1;
                for (let i = 0; i < suggestions.length; i++) {
                    if (suggestions[i].votes > maxVotes) {
                        maxVotes = suggestions[i].votes;
                        winnerIdx = i;
                    }
                }
                if (winnerIdx >= 0 && maxVotes > 0) {
                    winningSeats = suggestions[winnerIdx].seats;
                }
            }

            for (let row = 0; row < ROWS; row++) {
                const label = document.createElement('div');
                label.className = 'row-label';
                label.textContent = rowLabels[row];
                container.appendChild(label);

                for (let col = 0; col < COLS; col++) {
                    const idx = seatIndex(row, col);
                    const seat = document.createElement('div');
                    seat.textContent = col + 1;

                    const isSelected = selectedSeats.includes(idx);
                    const isSuggested = suggestions.length > 0 &&
                        currentSuggestionIdx >= 0 &&
                        suggestions[currentSuggestionIdx] &&
                        suggestions[currentSuggestionIdx].seats.includes(idx);
                    const isWinning = winningSeats.includes(idx);

                    let cls = 'seat ';
                    if (!available[idx]) cls += 'seat-taken';
                    else if (isWinning && !votingActive) cls += 'seat-voted';
                    else if (isSelected) cls += 'seat-selected';
                    else if (isSuggested) cls += 'seat-suggested';
                    else cls += 'seat-avail';

                    seat.className = cls;
                    seat.dataset.idx = idx;

                    if (available[idx]) {
                        (function(i) {
                            seat.onclick = function() {
                                if (votingActive) {
                                    document.getElementById('agentStatus').textContent = 'Voting in progress. Wait for results.';
                                    return;
                                }
                                const pos = selectedSeats.indexOf(i);
                                if (pos > -1) selectedSeats.splice(pos, 1);
                                else selectedSeats.push(i);
                                renderSeats();
                                updateStatus('Selected: ' + (selectedSeats.map(s => seatLabel(s)).join(', ') || 'none'));
                            };
                        })(idx);
                    }

                    container.appendChild(seat);
                }
            }

            const show = selectedSeats.length > 0 && !votingActive;
            document.getElementById('bookBtn').style.display = show ? 'inline-block' : 'none';
            document.getElementById('agentBookBtn').style.display = show ? 'inline-block' : 'none';
        }

        // Voting Logic
        function startVoting() {
            if (suggestions.length < 2) {
                document.getElementById('agentStatus').textContent = 'Need at least 2 options to vote.';
                return;
            }

            votingActive = true;
            hasVoted = false;
            votes = {};
            for (let i = 0; i < suggestions.length; i++) {
                votes[i] = 0;
                suggestions[i].votes = 0;
            }

            document.getElementById('votingBar').classList.remove('hidden');
            document.getElementById('votingStatus').textContent = 'Vote for your preferred seats!';
            document.getElementById('agentStatus').textContent = 'Voting open! Choose your option.';

            timeLeft = 120;
            updateTimerDisplay();

            clearInterval(timerInterval);
            timerInterval = setInterval(function() {
                timeLeft--;
                updateTimerDisplay();
                if (timeLeft <= 0) {
                    endVoting();
                }
            }, 1000);

            document.querySelectorAll('.rec-card').forEach(function(card, idx) {
                const btn = card.querySelector('.vote-btn');
                if (btn) {
                    btn.disabled = false;
                    btn.textContent = 'Vote';
                    btn.className = 'vote-btn';
                    btn.onclick = function(e) {
                        e.stopPropagation();
                        castVote(idx);
                    };
                }
            });

            sessionActive = true;
            updateStatus('Voting open! 2 minutes to choose.');

            // Notify backend API if session exists
            if (currentSessionId) {
                fetch('/api/sessions/' + currentSessionId + '/start-voting', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ durationSeconds: 120 })
                }).catch(() => {});
            }
        }

        function castVote(optionIdx) {
            if (!votingActive) {
                document.getElementById('agentStatus').textContent = 'Voting has ended.';
                return;
            }
            if (hasVoted) {
                document.getElementById('agentStatus').textContent = 'You already voted!';
                return;
            }

            votes[optionIdx] = (votes[optionIdx] || 0) + 1;
            suggestions[optionIdx].votes = votes[optionIdx];
            hasVoted = true;

            document.getElementById('votingStatus').textContent = 'You voted! Waiting for others...';
            document.getElementById('agentStatus').textContent = 'Vote cast for Option ' + (optionIdx + 1);

            // Update vote display
            document.querySelectorAll('.rec-card').forEach(function(card, idx) {
                const countEl = card.querySelector('.vote-count');
                if (countEl) {
                    countEl.textContent = suggestions[idx] ? suggestions[idx].votes + ' votes' : '0 votes';
                }
                const btn = card.querySelector('.vote-btn');
                if (btn) {
                    btn.textContent = suggestions[idx] ? suggestions[idx].votes + ' votes' : '0 votes';
                    btn.disabled = true;
                    btn.className = 'vote-btn voted-btn';
                }
            });

            // Post vote to API
            if (currentSessionId) {
                fetch('/api/sessions/' + currentSessionId + '/vote', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ optionIndex: optionIdx, voterName: 'Group Member' })
                }).catch(() => {});
            }

            const totalVotes = Object.values(votes).reduce((a, b) => a + b, 0);
            if (totalVotes >= groupSize) {
                document.getElementById('votingStatus').textContent = 'Everyone voted! Finalizing winner...';
                setTimeout(endVoting, 1200);
            }
        }

        function endVoting() {
            clearInterval(timerInterval);
            votingActive = false;

            let maxVotes = -1;
            let winnerIdx = -1;
            for (let i = 0; i < suggestions.length; i++) {
                if (suggestions[i].votes > maxVotes) {
                    maxVotes = suggestions[i].votes;
                    winnerIdx = i;
                }
            }

            const tied = [];
            for (let i = 0; i < suggestions.length; i++) {
                if (suggestions[i].votes === maxVotes) tied.push(i);
            }
            if (tied.length > 1) {
                let bestScore = -1;
                for (let i of tied) {
                    if (suggestions[i].score > bestScore) {
                        bestScore = suggestions[i].score;
                        winnerIdx = i;
                    }
                }
            }

            if (winnerIdx >= 0 && maxVotes > 0) {
                const winner = suggestions[winnerIdx];
                document.getElementById('votingStatus').textContent = 'Winner: Option ' + (winnerIdx + 1) + ' with ' + maxVotes + ' votes!';
                document.getElementById('agentStatus').textContent = winner.view + ' · ' + winner.leg + ' — Selected by group vote!';

                selectedSeats = winner.seats.slice();
                currentSuggestionIdx = winnerIdx;

                document.querySelectorAll('.rec-card').forEach(function(card, idx) {
                    if (idx === winnerIdx) {
                        card.classList.add('active');
                        const badge = card.querySelector('.tag-sm');
                        if (badge) badge.textContent = 'WINNER';
                    }
                    const btn = card.querySelector('.vote-btn');
                    if (btn) {
                        btn.disabled = true;
                        btn.textContent = suggestions[idx].votes + ' votes';
                    }
                    const countEl = card.querySelector('.vote-count');
                    if (countEl) {
                        countEl.textContent = suggestions[idx].votes + ' votes';
                    }
                });

                renderSeats();
                updateStatus('Winner: Option ' + (winnerIdx + 1) + ' — ' + winner.view + ', ' + winner.leg + ' (' + maxVotes + ' votes)');
                showToast('🎉 Winning option selected: Option ' + (winnerIdx + 1) + '!');

                if (currentSessionId) {
                    fetch('/api/sessions/' + currentSessionId + '/end-voting', { method: 'POST' }).catch(() => {});
                }
            } else {
                document.getElementById('votingStatus').textContent = 'No votes cast. Try again.';
                document.getElementById('agentStatus').textContent = 'No votes. Click "Find Seats" to restart.';
            }

            sessionActive = false;
        }

        function updateTimerDisplay() {
            const mins = Math.floor(timeLeft / 60);
            const secs = timeLeft % 60;
            document.getElementById('timerDisplay').textContent = mins + ':' + (secs < 10 ? '0' : '') + secs;
            if (timeLeft < 30) {
                document.getElementById('timerDisplay').style.color = '#dc2626';
            } else {
                document.getElementById('timerDisplay').style.color = '#92400e';
            }
        }

        // Start Session
        async function startSession(id) {
            selectedMovieId = id;
            selectedSeats = [];
            suggestions = [];
            currentSuggestionIdx = -1;
            votes = {};
            votingActive = false;
            sessionActive = false;
            hasVoted = false;
            clearInterval(timerInterval);

            // Fetch seats or generate random
            try {
                const res = await fetch('/api/movies/' + id + '/seats');
                const json = await res.json();
                if (json.data && json.data.seats) {
                    available = [...json.data.seats];
                } else {
                    shuffleSome();
                }
            } catch (err) {
                shuffleSome();
            }

            // Create backend session if possible
            try {
                const sessionRes = await fetch('/api/sessions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ movieId: id, groupSize: parseInt(document.getElementById('groupSize').value) })
                });
                const sessionJson = await sessionRes.json();
                if (sessionJson.data && sessionJson.data.session) {
                    currentSessionId = sessionJson.data.session.id;
                    window.location.href = '/session/' + encodeURIComponent(currentSessionId);
                    return;
                }
            } catch (e) {
                currentSessionId = 'session_' + Math.random().toString(36).substr(2, 6);
            }

            document.getElementById('movieList').classList.add('hidden');
            document.getElementById('sessionSection').classList.remove('hidden');
            document.getElementById('shareBanner').classList.remove('hidden');

            const mv = movies[id] || { title: id, venue: 'Cinema', time: 'Tonight' };
            document.getElementById('movieName').textContent = mv.title;
            document.getElementById('movieDetails').textContent = mv.venue + ' · ' + mv.time;
            document.getElementById('recContainer').innerHTML = '';
            document.getElementById('agentStatus').textContent = '';
            document.getElementById('votingBar').classList.add('hidden');
            document.getElementById('startVoteBtn').classList.add('hidden');
            document.getElementById('bookBtn').style.display = 'none';
            document.getElementById('agentBookBtn').style.display = 'none';

            renderSeats();
            updateStatus('Session started for ' + mv.title + '. Click "Find Seats" to get options.');
        }

        document.querySelectorAll('[data-start-session]').forEach(function(button) {
            button.addEventListener('click', function() {
                startSession(button.dataset.startSession);
            });
        });
        document.getElementById('backToMoviesBtn').addEventListener('click', backToMovies);
        document.getElementById('copySessionLinkBtn').addEventListener('click', copySessionLink);

        // Find Seats Button Click
        document.getElementById('findBtn').addEventListener('click', function() {
            groupSize = parseInt(document.getElementById('groupSize').value);
            const blocks = findBestBlocks(groupSize);

            if (blocks.length === 0) {
                document.getElementById('agentStatus').textContent = 'No adjacent seats available. Try smaller group.';
                updateStatus('No options found.');
                return;
            }

            suggestions = blocks;
            currentSuggestionIdx = -1;
            selectedSeats = [];
            votes = {};
            for (let i = 0; i < suggestions.length; i++) {
                suggestions[i].votes = 0;
            }
            hasVoted = false;
            votingActive = false;
            clearInterval(timerInterval);
            document.getElementById('votingBar').classList.add('hidden');

            const container = document.getElementById('recContainer');
            container.innerHTML = '';

            for (let i = 0; i < blocks.length; i++) {
                const b = blocks[i];
                const card = document.createElement('div');
                card.className = 'rec-card';

                const seatLabels = b.seats.map(s => seatLabel(s)).join(', ');

                let badgeHtml = '';
                if (b.view === 'Center view' && b.leg === 'Extra legroom') badgeHtml = '<span class="tag-sm tag-best">Best Overall</span>';
                else if (b.leg === 'Extra legroom') badgeHtml = '<span class="tag-sm tag-legroom">Extra Legroom</span>';
                else if (b.view === 'Center view') badgeHtml = '<span class="tag-sm tag-best">Best View</span>';
                else if (b.view === 'Good view' && b.leg === 'Good legroom') badgeHtml = '<span class="tag-sm tag-balanced">Balanced</span>';

                card.innerHTML =
                    '<div class="label">Option ' + (i + 1) + '</div>' +
                    '<div class="desc">Seats ' + seatLabels + '</div>' +
                    '<div class="desc">' + b.view + ' · ' + b.leg + '</div>' +
                    '<div class="vote-count">0 votes</div>' +
                    '<button class="vote-btn">Vote</button>' +
                    badgeHtml;

                (function(idx) {
                    card.onclick = function() {
                        if (votingActive) {
                            document.getElementById('agentStatus').textContent = 'Voting in progress. Use the vote button.';
                            return;
                        }
                        currentSuggestionIdx = idx;
                        selectedSeats = [];
                        document.querySelectorAll('.rec-card').forEach(el => el.classList.remove('active'));
                        card.classList.add('active');
                        const b2 = suggestions[idx];
                        document.getElementById('agentStatus').textContent = 'Selected: Option ' + (idx + 1) + ' (seats ' + b2.seats.map(s => seatLabel(s)).join(', ') + ')';
                        selectedSeats = b2.seats.slice();
                        renderSeats();
                        updateStatus('Selected: Option ' + (idx + 1) + ' — ' + b2.view + ', ' + b2.leg);
                    };

                    const voteBtn = card.querySelector('.vote-btn');
                    if (voteBtn) {
                        voteBtn.onclick = function(e) {
                            e.stopPropagation();
                            if (!votingActive) {
                                document.getElementById('agentStatus').textContent = 'Voting not active. Click "Find Seats" then vote.';
                                return;
                            }
                            castVote(idx);
                        };
                    }
                })(i);

                container.appendChild(card);
            }

            document.getElementById('startVoteBtn').classList.remove('hidden');
            document.getElementById('agentStatus').textContent = 'AI found ' + blocks.length + ' seat blocks. Select one to continue.';
            updateStatus('Found ' + blocks.length + ' options. Select a block to book or start a group vote.');
        });

        document.getElementById('startVoteBtn').addEventListener('click', function() {
            startVoting();
        });

        // End voting early
        document.getElementById('endVotingBtn').addEventListener('click', function() {
            if (votingActive) {
                endVoting();
                document.getElementById('votingStatus').textContent = 'Voting ended early by coordinator.';
                document.getElementById('agentStatus').textContent = 'Voting ended early.';
            }
        });

        // Manual booking - individual payment
        document.getElementById('bookBtn').addEventListener('click', async function() {
            if (selectedSeats.length === 0) return;
            const nums = selectedSeats.map(s => seatNumber(s));
            const button = this;
            button.disabled = true;
            button.textContent = 'Booking...';
            try {
                const response = await fetch('/api/sessions/' + currentSessionId + '/book', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ seatIndices: nums.map(n => n - 1), bookedBy: 'Group Member' })
                });
                const data = await response.json();
                if (!response.ok || !data.data?.booking?.bookingId) {
                    throw new Error(data.error?.message || 'Booking could not be completed.');
                }
                window.location.href = '/confirmation/' + data.data.booking.bookingId;
            } catch (error) {
                button.disabled = false;
                button.textContent = 'Confirm and pay';
                document.getElementById('agentStatus').textContent = error.message;
                updateStatus('Booking failed. Please choose available seats and try again.');
            }
        });

        // Agent books all (Stranger In The Middle books everyone)
        document.getElementById('agentBookBtn').addEventListener('click', function() {
            if (selectedSeats.length === 0) return;
            const nums = selectedSeats.map(s => seatNumber(s));
            let stillFree = true;
            nums.forEach(n => { if (!available[n - 1]) stillFree = false; });
            if (!stillFree) {
                document.getElementById('agentStatus').textContent = 'Some seats taken by others! Booking failed.';
                updateStatus('Booking failed — seats taken.');
                selectedSeats = [];
                renderSeats();
                return;
            }
            const result = bookTickets(selectedMovieId, nums);
            if (result.success) {
                selectedSeats = [];
                suggestions = [];
                currentSuggestionIdx = -1;
                document.getElementById('recContainer').innerHTML = '';
                document.getElementById('votingBar').classList.add('hidden');
                renderSeats();
                document.getElementById('agentStatus').textContent = 'Stranger In The Middle booked all seats!';
                updateStatus('Stranger booked seats ' + nums.map(n => seatLabel(n - 1)).join(', ') + ' for everyone.');
                showToast('Stranger In The Middle booked all tickets successfully!');
            } else {
                document.getElementById('agentStatus').textContent = 'Booking failed: ' + result.error;
                updateStatus('Stranger booking failed.');
            }
        });

        // Reset Session
        document.getElementById('resetBtn').addEventListener('click', function() {
            clearInterval(timerInterval);
            votingActive = false;
            sessionActive = false;
            selectedSeats = [];
            suggestions = [];
            currentSuggestionIdx = -1;
            votes = {};
            document.getElementById('recContainer').innerHTML = '';
            document.getElementById('votingBar').classList.add('hidden');
            document.getElementById('bookBtn').style.display = 'none';
            document.getElementById('agentBookBtn').style.display = 'none';
            document.getElementById('agentStatus').textContent = '';
            shuffleSome();
            renderSeats();
            updateStatus('Session reset. Click "Find Seats" to start again.');
            showToast('🔄 Session reset.');
        });

        // Book Tickets Core Helper
        function bookTickets(movieId, seats) {
            const indices = seats.map(n => n - 1);
            let allFree = true;
            indices.forEach(i => { if (i < 0 || i >= available.length || !available[i]) allFree = false; });
            if (!allFree) return { success: false, error: 'Seats taken.' };
            indices.forEach(i => { available[i] = false; });

            if (currentSessionId) {
                fetch('/api/sessions/' + currentSessionId + '/book', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ seatIndices: indices, bookedBy: 'Stranger In The Middle Agent' })
                }).catch(() => {});
            }

            return { success: true };
        }

        // Auto-load session if opened via direct URL /session/:id
        if (window.__SERVER_DATA__ && window.__SERVER_DATA__.initialSessionId) {
            startSession('spiderman');
        }

        // Expose helpers globally
        window.startSession = startSession;
        window.renderSeats = renderSeats;
        window.bookTickets = bookTickets;
        window.copySessionLink = copySessionLink;
        window.backToMovies = backToMovies;
    </script>

</body>
</html>